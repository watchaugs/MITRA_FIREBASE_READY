// ════════════════════════════════════════════════════════════════════════════════
// MITRA Dashboard — Firestore Security Rules v2.0
// Role-Based Access Control (RBAC) — DPDP Act 2023 Compliant
//
// Roles (stored in users/{userId}/role):
//   superadmin  – Full access to everything
//   admin       – Full access except audit log deletion
//   teacher     – Read curriculum, submit quizzes; no admin data
//   district    – Read analytics for their district only
//   content     – Upload AR assets, manage curriculum
//   viewer      – Read-only access to analytics and curriculum
// ════════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────────

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // True only when the caller already has a profile document. On a first-ever
    // login the doc does NOT exist yet, so get().data would error and DENY the
    // whole rule — every role check below must stay safe in that case.
    function hasProfile() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Get the user's role from their document. Returns '' when the profile does
    // not exist yet, so role checks evaluate to false instead of erroring.
    function userRole() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // Get the user's assigned state (null-safe, same reasoning as userRole).
    function userState() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assigned_state
        : '';
    }

    // Role checks
    function isSuperAdmin() { return isAuth() && userRole() == 'superadmin'; }
    function isAdmin()      { return isAuth() && (userRole() == 'admin' || userRole() == 'superadmin'); }
    function isTeacher()    { return isAuth() && userRole() == 'teacher'; }
    function isContent()    { return isAuth() && userRole() == 'content'; }
    function isDistrict()   { return isAuth() && userRole() == 'district'; }
    function isViewer()     { return isAuth() && userRole() == 'viewer'; }
    function isStaff()      { return isAdmin() || isTeacher() || isContent() || isDistrict() || isViewer(); }

    // Check if resource belongs to user's state
    function isMyState(stateField) {
      return resource.data[stateField] == userState() || userState() == 'All India';
    }

    // ── Users Collection ──────────────────────────────────────────────────────
    // Class may change only if the lock is absent or older than 90 days,
    // and the write must stamp class_locked_at to the server time.
    function classChangeAllowed() {
      return request.resource.data.class_grade == resource.data.class_grade
        || (
             (
               !('class_locked_at' in resource.data)
               || resource.data.class_locked_at == null
               || request.time > resource.data.class_locked_at + duration.value(90, 'd')
             )
             && request.resource.data.class_locked_at == request.time
           );
    }

    // ── app_users = APP (student / app-teacher) profiles ──────────────────────
    // IMPORTANT: this collection holds the STUDENT/app profiles created from the
    // mobile app. Dashboard STAFF (admin/content/district/viewer) live in a
    // SEPARATE collection, `dashboard_users`, which is reached only through the
    // backend Admin SDK (see below) — never written here. So these rules are
    // pure self-service: a signed-in app user owns exactly their own
    // app_users/{uid} document, and can never create a staff/admin account or
    // grant permissions.
    match /app_users/{userId} {
      // Read only your own profile. (Staff tooling reads via the Admin SDK,
      // which bypasses rules, so no admin branch is needed here.)
      allow read: if isAuth() && request.auth.uid == userId;

      // Create ONLY your own profile, ONLY as a non-privileged app role
      // (student/teacher), with NO permission fields. No get() is used, so a
      // first-ever login (where the doc doesn't exist yet) is never denied.
      allow create: if isAuth()
        && request.auth.uid == userId
        && (!('role' in request.resource.data)
            || request.resource.data.role == 'student')
        && !request.resource.data.keys().hasAny(['perm_publish_apps',
             'perm_upload_unity', 'perm_manage_geo', 'perm_view_analytics',
             'perm_create_users', 'perm_edit_curriculum', 'perm_approve_content',
             'perm_export_data', 'perm_manage_ads']);

      // Update your own profile, but never change role into a privileged one and
      // never add permission fields. Class-change lock still applies.
      allow update: if isAuth()
        && request.auth.uid == userId
        && (!('role' in request.resource.data)
            || request.resource.data.role == 'student')
        && !request.resource.data.keys().hasAny(['perm_publish_apps',
             'perm_upload_unity', 'perm_manage_geo', 'perm_view_analytics',
             'perm_create_users', 'perm_edit_curriculum', 'perm_approve_content',
             'perm_export_data', 'perm_manage_ads'])
        && classChangeAllowed();

      // App users don't delete their own profile from the client; erasure runs
      // through the backend (DPDPA flow) with the Admin SDK.
      allow delete: if false;
    }

    // ── Dashboard staff profiles — backend-only ───────────────────────────────
    // Staff (admin/content/district/viewer/teacher-of-dashboard) live here and
    // are managed exclusively through the backend API (Admin SDK bypasses these
    // rules). No client — app or dashboard web — may touch this collection
    // directly, so it is locked to deny-all here.
    match /dashboard_users/{staffId} {
      allow read, write: if false;
    }

    // ── AR Assets ─────────────────────────────────────────────────────────────
    match /ar_assets/{assetId} {
      // Teachers, content managers, admins can read assets for their state
      allow read: if isStaff() && isMyState('target_state');

      // Content managers and admins can create/update
      allow create, update: if isContent() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Curriculum ────────────────────────────────────────────────────────────
    match /curriculum/{nodeId} {
      allow read: if isStaff();
      allow create, update: if isContent() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Quizzes ───────────────────────────────────────────────────────────────
    match /quizzes/{quizId} {
      // All staff can read quizzes for their state
      allow read: if isStaff();

      // Teachers and content managers can create/edit quizzes
      allow create: if isTeacher() || isContent() || isAdmin();
      allow update: if (isTeacher() && resource.data.created_by == request.auth.uid) ||
                       isContent() || isAdmin();

      // Only admins can delete/archive
      allow delete: if isAdmin();

      // Quiz Questions (subcollection)
      match /questions/{questionId} {
        allow read: if isStaff();
        allow create, update: if isTeacher() || isContent() || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── Quiz Attempts (Student Data — DPDP Sensitive) ─────────────────────────
    match /quiz_attempts/{attemptId} {
      // Teachers can read attempts for their class; district can read aggregate
      // NEVER expose raw student PII to viewer role
      allow read: if isAdmin() ||
        (isTeacher() && isMyState('state')) ||
        (isDistrict() && isMyState('state'));

      // Students submit attempts (mobile app auth)
      allow create: if isAuth();

      // No one can modify submitted attempts (data integrity)
      allow update: if false;

      // Only admin can purge (DPDP Right to Erasure)
      allow delete: if isAdmin();
    }

    // ── Analytics ─────────────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read: if isStaff() && (isAdmin() || isMyState('state'));
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /push_notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Geofences ─────────────────────────────────────────────────────────────
    match /geofences/{geoId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Audit Logs (CERT-In: 180-day retention, no deletion except superadmin) ─
    match /audit_logs/{logId} {
      // Only admins can read audit logs (sensitive security data)
      allow read: if isAdmin();

      // System creates audit logs; no manual creation by users
      allow create: if isAdmin();

      // Audit logs CANNOT be modified (tamper-proof)
      allow update: if false;

      // Only superadmin can delete (for right to erasure compliance with log anonymisation)
      allow delete: if isSuperAdmin();
    }

    // ── Compliance Settings ───────────────────────────────────────────────────
    // Admins read everything. The signed-in app may read ONLY the two public
    // officer-contact docs (Grievance Officer / DPO) — meant to be publicly
    // listed under the DPDPA.
    match /compliance_settings/{settingId} {
      allow read: if isAdmin()
        || (isAuth() && settingId in ['grievance_officer', 'dpo_info']);
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Published Apps / State Apps ───────────────────────────────────────────
    match /state_apps/{appId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Incident Reports (CERT-In) ────────────────────────────────────────────
    match /incident_reports/{reportId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Students (app: telemetry read + setup write) ─────────────────────────
    match /students/{studentId} {
      allow read: if isAuth() && (request.auth.uid == studentId || isAdmin()
        || (isTeacher() && isMyState('state')));
      allow write: if isAuth() && request.auth.uid == studentId;
    }

    // ── Public compliance config (Grievance Officer / DPO) ───────────────────
    // Dashboard writes; app reads officer details with a student token.
    match /public_config/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ── Telemetry sync (app writes its own batches; admins read) ─────────────
    // The app writes telemetry_sync/{uid}/{collection}.
    match /telemetry_sync/{uid}/{document=**} {
      allow write: if isAuth() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ── DPDPA data requests (export / deletion) ──────────────────────────────
    // A student files/reads their own request; the compliance team actions it.
    match /data_requests/{requestId} {
      allow create, update: if isAuth()
        && request.resource.data.student_id == request.auth.uid;
      allow read: if isAdmin()
        || (isAuth() && resource.data.student_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Default: Deny everything else ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
